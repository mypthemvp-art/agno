# StrategyIQ Environment Variables

# Database
DATABASE_URL=postgresql+asyncpg://strategyiq:strategyiq@localhost:5432/strategyiq

# Redis
REDIS_URL=redis://localhost:6379/0

# Market Data APIs (never scrape — use official APIs only)
POLYGON_API_KEY=
COINGECKO_API_KEY=
FMP_API_KEY=

# Pinecone (vector search for agents)
PINECONE_API_KEY=
PINECONE_INDEX=strategyiq

# Grok (breaking/trending queries)
GROK_API_KEY=

# Stripe (subscription tiers)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ELITE_PRICE_ID=

# JWT
JWT_SECRET=change-me-in-production

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
